FROM python:3.11-slim

WORKDIR /app

# Copiar requirements
COPY requirements.txt .

# Instalar dependencias
RUN pip install --no-cache-dir -r requirements.txt

# Copiar archivo principal
COPY main.py .

# Copiar SOLO la carpeta pdf_generator
# IMPORTANTE: Mantener la estructura src/main/pdf_generator
COPY src/main/pdf_generator ./src/main/pdf_generator/

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]